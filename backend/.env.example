# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# The long ID in the sheet's URL: docs.google.com/spreadsheets/d/{THIS}/edit
SPREADSHEET_ID=15uOPl0A_i2_-Cgks8PoqM7nzviBU3LhC-TEodP-udZQ

# Path to the service account JSON key (Viewer access on the sheet).
# Keep this file outside the repo entirely, or make sure it's gitignored
# if it lives inside it.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json

# Alternative to the path above: paste the full JSON key as a single-line
# string here instead (useful for platforms like Heroku/Render that only
# offer env vars, no file storage). If both are set, this one wins.
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account",...}

# How long fetched KPI values are cached in memory before the next request
# re-hits the Sheets API. The n8n heartbeat only forces a sheet
# recalculation once a minute, so a lower value than that doesn't buy you
# fresher data, only more API calls.
CACHE_TTL_SECONDS=20
